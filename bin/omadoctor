#!/usr/bin/python3
"""OmaDoctor: find problems in Omarchy shell plugins and bar setup."""

import os
import sys

# This script lives in a plugin folder, and the shell reloads its plugins
# whenever a file there changes. Never leave __pycache__ behind.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from doctor.cli import main  # noqa: E402

sys.exit(main())
